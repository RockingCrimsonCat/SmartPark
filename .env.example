# Зразок налаштувань для docker-compose.
# Скопіюйте у файл .env (він не потрапляє в git) і задайте власні значення:
#   cp .env.example .env
# Без файлу .env використовуються значення для локальної розробки.

# Адреса, на якій відкриваються порти:
#   127.0.0.1 – лише цей комп’ютер (рекомендовано);
#   0.0.0.0   – усі мережі (лише для сервера за файрволом і з власними ключами нижче).
BIND_ADDRESS=127.0.0.1

# Адреса веб-клієнта для посилань на оплату (QR-код на табло).
PUBLIC_URL=http://localhost:8080

# Ключ підпису JWT – випадковий рядок довжиною не менше 32 символів.
JWT_KEY=change-me-to-a-long-random-string-at-least-32-chars

# Ключ edge-шлюзу (симулятора паркінгу).
EDGE_KEY=change-me-edge-key

# Пароль бази даних. Діє лише під час першого створення тому pgdata
# (щоб змінити для наявної бази: docker compose down -v – дані буде видалено).
DB_PASSWORD=change-me-db-password

# Пароль тестових користувачів, що створюються при першому запуску.
SEED_PASSWORD=Test#12345

# Імовірність відмови фейкового платіжного провайдера (0…1).
PAYMENT_FAILURE_RATE=0.1
